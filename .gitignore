.DS_Store

# Local secrets
.env
.env.*

# Local tool/runtime caches
.ruff_cache/
.serena/
.claude/

# Python virtual/build caches
__pycache__/
*.pyc

# Xcode / build artifacts outside subprojects
ios/build/

# Tool output
.local/

# Large on-device model outputs (download / prepare locally)

# Android / RN local build caches
mobile/android/.gradle/
mobile/android/app/.cxx/
mobile/android/build/
mobile/android/.kotlin/
mobile/android/app/src/main/assets/index.android.bundle

# Android local environment (machine-specific, never commit)
mobile/android/local.properties

# Android signing credentials (sensitive — back up separately)
mobile/android/key.properties
mobile/android/keyStore

# Large bundled model binaries for Android (gitignored like iOS assets/models)
mobile/android/app/src/main/assets/models/**/*.onnx

# Local packaged archives / embedded debug bundles
mobile.zip
mobile 2.zip
mobile/ios/main.jsbundle

# Large bundled model binaries (keep folder docs only)
mobile/assets/models/**/*.onnx
mobile/assets/models/**/*.model
mobile/assets/models/**/vocab.json
!mobile/assets/models/**/README.md

# Temporary extracted speaker diarization archives
mobile/assets/models/speaker-diarization/*.tar.bz2
mobile/assets/models/speaker-diarization/sherpa-onnx-pyannote-segmentation-3-0/

# Brainstorming mockups (visual companion)
